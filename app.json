{
  "expo": {
    "name": "Workout Tracker",
    "slug": "workout-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "backgroundColor": "#0F0F0F",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "workouttracker",
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jercahdz.workouttrackerapp"
    },
    "web": {
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f5901ae-993b-4892-b448-ea8a67d8b0b0"
      }
    }
  }
}
